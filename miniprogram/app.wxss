/* app.wxss - 全局样式 */

page {
  background-color: #0A0A0A;
  color: #E8E0D4;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  min-height: 100vh;
}

/* 噪点纹理 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}

.page-content {
  position: relative;
  z-index: 1;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulseGlow {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.08); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

.anim-fade-in {
  animation: fadeIn 0.6s ease forwards;
}

/* 输入框 */
.input-area {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(154, 145, 138, 0.12);
  background-color: #111111;
  color: #E8E0D4;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.input-area:focus {
  border-color: #C9A55C;
  box-shadow: 0 0 30rpx rgba(201, 165, 92, 0.15);
}

/* 情绪芯片 */
.emotion-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: 1rpx solid rgba(154, 145, 138, 0.25);
  background: transparent;
  color: #9A918A;
  transition: all 0.3s ease;
  margin: 6rpx;
}

.emotion-chip.active {
  background: #C9A55C;
  color: #0A0A0A;
  border-color: #C9A55C;
  box-shadow: 0 0 16rpx rgba(201, 165, 92, 0.3);
}

.emotion-chip.disabled {
  opacity: 0.4;
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 20rpx;
  background: #C9A55C;
  color: #0A0A0A;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(201, 165, 92, 0.3);
}

.btn-primary.disabled {
  opacity: 0.4;
}

/* 次按钮 */
.btn-secondary {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 20rpx;
  background: transparent;
  color: #9A918A;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: 1rpx solid rgba(154, 145, 138, 0.25);
}

.btn-secondary:active {
  background: rgba(201, 165, 92, 0.08);
}

/* 文字链接 */
.text-link {
  color: #5A534D;
  font-size: 26rpx;
  text-align: center;
  padding: 16rpx 0;
  background: none;
  border: none;
}

/* 卡片 */
.memory-card {
  border-radius: 24rpx;
  overflow: hidden;
  background: #141414;
  border: 1rpx solid rgba(154, 145, 138, 0.12);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* 分组标题 */
.group-label {
  font-size: 22rpx;
  color: #5A534D;
  margin-bottom: 12rpx;
  margin-top: 20rpx;
}

/* 复选框 */
.checkbox-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(154, 145, 138, 0.25);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #C9A55C;
  border-color: #C9A55C;
}

/* 加载步骤 */
.loading-step {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.5s ease;
}

.loading-step.active {
  background: rgba(201, 165, 92, 0.15);
}

/* 入场动画 */
.intro-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0A0A0A;
}

.intro-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C9A55C;
  box-shadow: 0 0 40rpx #C9A55C, 0 0 80rpx rgba(201, 165, 92, 0.15);
  animation: pulseGlow 2s ease-in-out infinite;
}

.intro-text {
  font-size: 32rpx;
  color: #9A918A;
  letter-spacing: 4rpx;
  animation: fadeIn 1.2s ease forwards;
}
