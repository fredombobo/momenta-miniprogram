<!--pages/result/result.wxml-->
<view class="page-bg"></view>
<view class="page-content">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-inner">
      <view class="nav-back" bindtap="goBack">
        <text class="nav-back-icon">‹</text>
        <text class="nav-back-text">返回</text>
      </view>
      <text class="nav-title">记忆卡片</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="result-section" style="padding-top: {{navBarHeight + 16}}px;" wx:if="{{result}}">
    <!-- 记忆卡片 -->
    <view class="memory-card" id="memoryCard">
      <view class="card-image-wrap" wx:if="{{result.imageUrl}}">
        <image
          class="card-image"
          src="{{result.imageUrl}}"
          mode="aspectFill"
          show-menu-by-longpress
        />
        <view class="card-overlay">
          <text class="card-user-text" wx:if="{{showText}}">「{{userText}}」</text>
          <text class="card-timestamp">{{formattedTime}}</text>
        </view>
      </view>
      <view class="card-image-error" wx:else>
        <text>图片生成失败</text>
        <text class="card-image-error-sub">解读仍可用，可返回重试</text>
      </view>

      <view class="card-body">
        <view class="card-category">
          <view class="category-dot" style="background: {{result.emotionColor || '#C9A55C'}};"></view>
          <text class="category-name" style="color: {{result.emotionColor || '#C9A55C'}};">{{result.category}}</text>
        </view>

        <text class="card-interpretation" wx:if="{{result.interpretation}}">{{result.interpretation}}</text>

        <view class="card-divider" style="background: linear-gradient(to right, transparent, {{result.emotionColor || '#C9A55C'}}33, transparent);"></view>

        <view class="checkbox-wrap" bindtap="toggleShowText">
          <view class="checkbox {{showText ? 'checked' : ''}}">
            <text wx:if="{{showText}}" style="font-size: 18rpx; color: #0A0A0A;">✓</text>
          </view>
          <text class="checkbox-label">在卡片上显示我的文字</text>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn-primary" bindtap="saveCard" loading="{{saving}}" disabled="{{saving}}">
        保存记忆卡片
      </button>
      <button class="btn-secondary" bindtap="shareCard">分享给朋友</button>
      <button class="text-link" bindtap="generateAgain">再冻结一个瞬间 →</button>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">Momenta凝刻 — 每个瞬间都值得被冻结</text>
  </view>

  <!-- 离屏合成画布（不可见） -->
  <canvas
    canvas-id="cardCanvas"
    class="offscreen-canvas"
    style="width: 750px; height: 1400px;"
  ></canvas>
</view>
