.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(10, 10, 10, 0.92);
  border-bottom: 1rpx solid rgba(154, 145, 138, 0.12);
}

.custom-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  min-width: 120rpx;
  color: #c9a55c;
}

.nav-back-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.nav-back-text {
  font-size: 28rpx;
}

.nav-title {
  font-size: 30rpx;
  color: #e8e0d4;
  font-weight: 500;
}

.nav-placeholder {
  min-width: 120rpx;
}

.premium-body {
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 80rpx;
}

.status-card {
  background: #141414;
  border: 1rpx solid rgba(201, 165, 92, 0.25);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  position: relative;
}

.status-label {
  font-size: 22rpx;
  color: #5a534d;
  display: block;
  margin-bottom: 12rpx;
}

.status-value {
  font-size: 36rpx;
  color: #e8e0d4;
  font-weight: 500;
  display: block;
}

.status-value.accent {
  color: #c9a55c;
}

.status-sub {
  font-size: 24rpx;
  color: #9a918a;
  display: block;
  margin-top: 8rpx;
}

.mock-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 20rpx;
  color: #c9a55c;
  border: 1rpx solid #c9a55c;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  color: #e8e0d4;
  display: block;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.benefits {
  margin-bottom: 40rpx;
}

.benefit-item {
  display: block;
  font-size: 26rpx;
  color: #9a918a;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.product-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #141414;
  border: 1rpx solid rgba(154, 145, 138, 0.12);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.product-card:active {
  border-color: #c9a55c;
  background: rgba(201, 165, 92, 0.06);
}

.product-name {
  font-size: 30rpx;
  color: #e8e0d4;
  display: block;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 22rpx;
  color: #5a534d;
  display: block;
}

.product-right {
  text-align: right;
}

.product-price {
  font-size: 34rpx;
  color: #c9a55c;
  font-weight: 600;
  display: block;
}

.product-cta {
  font-size: 22rpx;
  color: #9a918a;
  margin-top: 6rpx;
  display: block;
}

.pay-hint {
  display: block;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #5a534d;
  line-height: 1.6;
}

.loading-text {
  color: #5a534d;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}
