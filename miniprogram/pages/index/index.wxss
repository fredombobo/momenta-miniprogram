/* pages/index/index.wxss */

.flex-col-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gap-40 {
  gap: 40rpx;
}

/* Hero */
.hero-section {
  text-align: center;
  padding: 40rpx 40rpx 60rpx;
}

.hero-title-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  color: #E8E0D4;
}

.hero-title-sub {
  font-size: 36rpx;
  color: #C9A55C;
  margin-left: 4rpx;
}

.hero-subtitle {
  font-size: 30rpx;
  color: #9A918A;
  font-weight: 300;
  margin-top: 12rpx;
}

/* Input Section */
.input-section {
  padding: 0 40rpx;
  padding-bottom: 60rpx;
}

.input-wrap {
  margin-bottom: 40rpx;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #5A534D;
  margin-top: 8rpx;
}

/* Emotion Section */
.emotion-section {
  margin-bottom: 48rpx;
}

.emotion-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.emotion-label {
  font-size: 26rpx;
  color: #9A918A;
}

.emotion-count {
  font-size: 22rpx;
  color: #5A534D;
}

.emotion-chips-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

/* Free Usage Hint */
.free-usage-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(201, 165, 92, 0.08);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #9A918A;
}

.btn-upgrade-small {
  font-size: 24rpx;
  color: #C9A55C;
  padding: 4rpx 16rpx;
  border: 1rpx solid #C9A55C;
  border-radius: 20rpx;
}

.error-text {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #C9544D;
}

/* Loading Section */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.loading-glow-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 60rpx;
}

.loading-glow {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background: radial-gradient(circle, #C9A55C 0%, transparent 70%);
  animation: pulseGlow 2.5s ease-in-out infinite;
}

.loading-glow-inner {
  position: absolute;
  top: 24rpx; left: 24rpx; right: 24rpx; bottom: 24rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #C9A55C 0%, transparent 60%);
  opacity: 0.5;
  animation: pulseGlow 2.5s ease-in-out infinite;
  animation-delay: 0.5s;
}

.loading-steps {
  width: 100%;
}

.step-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.step-text {
  font-size: 26rpx;
}

.step-shimmer {
  margin-left: auto;
  width: 80rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(201, 165, 92, 0.15) 50%, transparent 100%);
  background-size: 200% 100%;
  animation: shimmer 2s ease-in-out infinite;
}
